class Solution {
    int maxSubarraySum(int[] arr) {
        // Code here
        
        int m = arr[0];
        for(int i = 0 ; i < arr.length ; i++){
            int sum = 0;
            for(int j = i ; j < arr.length ; j++){
             sum +=arr[j];
             
            m = Math.max(sum , m );
            }
        }
        return m ;
    }
}
