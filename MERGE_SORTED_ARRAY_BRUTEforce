// APPROACH 1: Brute Force / In-place + Sorting
// Time: O((m + n) log(m + n))
// Space: O(1) extra space
// We first copy nums2 into the empty spaces of nums1,
// then sort nums1.


class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {

        // Copy nums2 elements into the empty positions of nums1
        for (int j = 0, i = m; j < n; j++) {
            nums1[i] = nums2[j];
            i++;
        }

        // Sort the complete array
        Arrays.sort(nums1);
    }
}




// APPROACH 2: Brute Force / Extra Array + Sorting
// Time: O((m + n) log(m + n))
// Space: O(m + n)
// We create a new array, copy both arrays into it,
// sort it, and finally copy the result back to nums1.

class Solution {
    public void merge(int[] nums1, int m, int[] nums2, int n) {

        // Create a new array of required size
        int[] arr = new int[m + n];

        // Copy valid elements from nums1
        for (int i = 0; i < m; i++) {
            arr[i] = nums1[i];
        }

        // Copy elements from nums2
        for (int i = 0; i < n; i++) {
            arr[m + i] = nums2[i];
        }

        // Sort the combined array
        Arrays.sort(arr);

        // Copy sorted elements back into nums1
        for (int i = 0; i < m + n; i++) {
            nums1[i] = arr[i];
        }
    }
}
